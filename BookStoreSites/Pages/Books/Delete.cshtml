@page "{id:int}"
@model BookStoreSites.Pages.Books.DeleteModel
@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this book?</h3>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Book.Title</dd>

            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.Book.Author</dd>

            <dt class="col-sm-3">Publisher</dt>
            <dd class="col-sm-9">@Model.Book.Publisher</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@Model.Book.Price.ToString("C")</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Book.Id" />
            <div class="form-group">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
